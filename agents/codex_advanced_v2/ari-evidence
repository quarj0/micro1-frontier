#!/usr/bin/env python3
"""Execute one command and emit an immutable structured evidence receipt."""

from __future__ import annotations

import argparse
import base64
import hashlib
import json
import os
import shlex
import subprocess
import sys
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any


PHASES = (
    "reproduction",
    "investigation",
    "focused_verification",
    "broad_verification",
)
EXCERPT_LIMIT = 8_000


def utc_now() -> str:
    return datetime.now(UTC).isoformat()


def require_path(name: str) -> Path:
    value = os.environ.get(name)
    if not value:
        raise RuntimeError(f"required environment variable is unset: {name}")
    return Path(value).resolve()


def source_changes(workspace: Path, baseline: str) -> list[str]:
    changed = subprocess.run(
        ["git", "diff", "--name-only", baseline, "--"],
        cwd=workspace,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    untracked = subprocess.run(
        ["git", "ls-files", "--others", "--exclude-standard"],
        cwd=workspace,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        check=False,
    )
    paths = set(changed.stdout.splitlines()) | set(untracked.stdout.splitlines())
    return sorted(
        path
        for path in paths
        if path != "ISSUE.md" and path != ".ari" and not path.startswith(".ari/")
    )


def retained_excerpt(value: bytes) -> str:
    text = value.decode("utf-8", errors="replace")
    if len(text) <= EXCERPT_LIMIT:
        return text
    half = EXCERPT_LIMIT // 2
    return f"{text[:half]}\n... [excerpt truncated] ...\n{text[-half:]}"


def next_order(path: Path) -> int:
    if not path.exists():
        return 1
    return 1 + sum(1 for line in path.read_text(encoding="utf-8").splitlines() if line.strip())


def record_digest(record: dict[str, Any]) -> str:
    payload = json.dumps(record, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(payload).hexdigest()


def main() -> int:
    parser = argparse.ArgumentParser(prog="ari-evidence")
    parser.add_argument("--phase", choices=PHASES, required=True)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = list(args.command)
    if command[:1] == ["--"]:
        command = command[1:]
    if not command:
        parser.error("a command is required after --")

    workspace = require_path("ARI_WORKSPACE")
    evidence_path = require_path("ARI_COMMAND_EVIDENCE_PATH")
    marker_path = require_path("ARI_FIRST_EDIT_MARKER_PATH")
    baseline = os.environ.get("ARI_BASELINE_REVISION")
    if not baseline:
        raise RuntimeError("required environment variable is unset: ARI_BASELINE_REVISION")

    evidence_path.parent.mkdir(parents=True, exist_ok=True)
    preexisting_marker = marker_path.exists()
    changes_before = source_changes(workspace, baseline)
    if changes_before and not preexisting_marker:
        marker_path.write_text(utc_now() + "\n", encoding="utf-8")
    edit_state = (
        "after_first_source_edit"
        if preexisting_marker or changes_before
        else "before_first_source_edit"
    )

    started_at = utc_now()
    launch_error: str | None = None
    try:
        completed = subprocess.run(
            command,
            cwd=workspace,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=False,
        )
        stdout = completed.stdout
        stderr = completed.stderr
        exit_code = completed.returncode
    except OSError as exc:
        stdout = b""
        stderr = f"{type(exc).__name__}: {exc}\n".encode()
        exit_code = 127
        launch_error = f"{type(exc).__name__}: {exc}"
    finished_at = utc_now()

    changes_after = source_changes(workspace, baseline)
    if edit_state == "before_first_source_edit" and changes_after:
        edit_state = "spans_first_source_edit"
        marker_path.write_text(finished_at + "\n", encoding="utf-8")

    record: dict[str, Any] = {
        "event_id": f"ev-{next_order(evidence_path):04d}-{uuid.uuid4().hex[:8]}",
        "order": next_order(evidence_path),
        "phase": args.phase,
        "command": command,
        "command_text": shlex.join(command),
        "started_at": started_at,
        "finished_at": finished_at,
        "exit_code": exit_code,
        "stdout_sha256": hashlib.sha256(stdout).hexdigest(),
        "stderr_sha256": hashlib.sha256(stderr).hexdigest(),
        "stdout_excerpt": retained_excerpt(stdout),
        "stderr_excerpt": retained_excerpt(stderr),
        "edit_state": edit_state,
        "source_changes_before": changes_before,
        "source_changes_after": changes_after,
        "launch_error": launch_error,
    }
    digest = record_digest(record)
    record["record_sha256"] = digest
    with evidence_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(record, sort_keys=True) + "\n")

    sys.stdout.buffer.write(stdout)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(stderr)
    receipt = base64.urlsafe_b64encode(
        json.dumps(
            {"event_id": record["event_id"], "record_sha256": digest},
            sort_keys=True,
            separators=(",", ":"),
        ).encode()
    ).decode()
    print(f"ARI_EVIDENCE_EVENT_ID={record['event_id']}", file=sys.stderr)
    print(f"ARI_EVIDENCE_RECEIPT={receipt}", file=sys.stderr)
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
