@@ -19,3 +19,21 @@ class ProjectDetailSmokeTests(APITestCase):

         self.assertEqual(response.status_code, 200)
         self.assertEqual(response.json()["name"], "Synthetic Project")
+
+    def test_tenant_cannot_retrieve_another_tenants_project(self):
+        alpha = Tenant.objects.create(name="Alpha Tenant")
+        beta = Tenant.objects.create(name="Beta Tenant")
+        project = Project.objects.create(
+            tenant=beta,
+            name="Beta Project",
+            confidential_summary="beta secret",
+        )
+
+        response = self.client.get(
+            f"/api/projects/{project.pk}/",
+            HTTP_X_TENANT_ID=str(alpha.pk),
+        )
+
+        self.assertEqual(response.status_code, 404)
+        self.assertNotContains(response, "Beta Project", status_code=404)
+        self.assertNotContains(response, "beta secret", status_code=404)
