+    def test_manager_cannot_approve_expense_for_sibling_project(self):
+        tenant = Tenant.objects.create(name="Synthetic Tenant")
+        manager = StaffUser.objects.create(tenant=tenant, name="Synthetic Manager")
+        managed_project = Project.objects.create(
+            tenant=tenant,
+            name="Managed Project",
+        )
+        sibling_project = Project.objects.create(
+            tenant=tenant,
+            name="Sibling Project",
+        )
+        ProjectMembership.objects.create(
+            project=managed_project,
+            user=manager,
+            role=ProjectMembership.MANAGER,
+        )
+        expense = Expense.objects.create(
+            tenant=tenant,
+            project=sibling_project,
+            description="Sibling project expense",
+            amount_cents=5000,
+        )
+
+        response = self.client.post(
+            f"/api/expenses/{expense.pk}/approve/",
+            HTTP_X_TENANT_ID=str(tenant.pk),
+            HTTP_X_USER_ID=str(manager.pk),
+        )
+
+        self.assertEqual(response.status_code, 403)
+        expense.refresh_from_db()
+        self.assertEqual(expense.status, Expense.PENDING)
+        self.assertIsNone(expense.approved_by)
+
+    def test_manager_from_another_tenant_cannot_approve_expense(self):
+        expense_tenant = Tenant.objects.create(name="Expense Tenant")
+        manager_tenant = Tenant.objects.create(name="Manager Tenant")
+        manager = StaffUser.objects.create(
+            tenant=manager_tenant,
+            name="Other Tenant Manager",
+        )
+        project = Project.objects.create(tenant=expense_tenant, name="Expense Project")
+        ProjectMembership.objects.create(
+            project=project,
+            user=manager,
+            role=ProjectMembership.MANAGER,
+        )
+        expense = Expense.objects.create(
+            tenant=expense_tenant,
+            project=project,
+            description="Tenant-isolated expense",
+            amount_cents=5000,
+        )
+
+        response = self.client.post(
+            f"/api/expenses/{expense.pk}/approve/",
+            HTTP_X_TENANT_ID=str(expense_tenant.pk),
+            HTTP_X_USER_ID=str(manager.pk),
+        )
+
+        self.assertEqual(response.status_code, 404)
+        expense.refresh_from_db()
+        self.assertEqual(expense.status, Expense.PENDING)
+        self.assertIsNone(expense.approved_by)
