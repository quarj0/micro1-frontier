+
+    def test_manager_cannot_approve_sibling_project_expense(self):
+        tenant = Tenant.objects.create(name="Synthetic Tenant")
+        manager = StaffUser.objects.create(tenant=tenant, name="Synthetic Manager")
+        managed_project = Project.objects.create(tenant=tenant, name="Managed Project")
+        sibling_project = Project.objects.create(tenant=tenant, name="Sibling Project")
+        ProjectMembership.objects.create(
+            project=managed_project,
+            user=manager,
+            role=ProjectMembership.MANAGER,
+        )
+        expense = Expense.objects.create(
+            tenant=tenant,
+            project=sibling_project,
+            description="Synthetic expense",
+            amount_cents=5000,
+        )
+
+        response = self.client.post(
+            f"/api/expenses/{expense.pk}/approve/",
+            HTTP_X_TENANT_ID=str(tenant.pk),
+            HTTP_X_USER_ID=str(manager.pk),
+        )
+
+        self.assertEqual(response.status_code, 403)
+        expense.refresh_from_db()
+        self.assertEqual(expense.status, Expense.PENDING)
+        self.assertIsNone(expense.approved_by)
